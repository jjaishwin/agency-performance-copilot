{
  "name": "Agency Copilot",
  "dataColors": ["#0B3D6E", "#2F7DC1", "#7FB2E5", "#C8102E", "#F2A900", "#4C9A6A", "#6B7785", "#A3AEBB"],
  "background": "#FFFFFF",
  "foreground": "#1F2A37",
  "tableAccent": "#0B3D6E",
  "good": "#2E7D32",
  "neutral": "#B26A00",
  "bad": "#C62828",
  "maximum": "#0B3D6E",
  "center": "#E8EEF5",
  "minimum": "#C8102E",
  "textClasses": {
    "callout": { "fontSize": 30, "fontFace": "Segoe UI Semibold", "color": "#0B1F33" },
    "title":   { "fontSize": 13, "fontFace": "Segoe UI Semibold", "color": "#1F2A37" },
    "header":  { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1F2A37" },
    "label":   { "fontSize": 11, "fontFace": "Segoe UI", "color": "#3B4754" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#DDE3EA" } }, "radius": 8 }],
        "title": [{ "show": true, "fontSize": 13, "fontColor": { "solid": { "color": "#1F2A37" } } }],
        "categoryAxis": [{ "fontSize": 11, "labelColor": { "solid": { "color": "#3B4754" } } }],
        "valueAxis": [{ "fontSize": 10, "labelColor": { "solid": { "color": "#6B7785" } }, "gridlineColor": { "solid": { "color": "#EEF1F5" } } }],
        "labels": [{ "fontSize": 11, "color": { "solid": { "color": "#1F2A37" } } }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F3F5F8" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#E9EDF2" } }, "transparency": 0 }]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [{ "fontSize": 11, "fontColor": { "solid": { "color": "#FFFFFF" } }, "backColor": { "solid": { "color": "#0B3D6E" } } }],
        "values": [{ "fontSize": 11, "backColorPrimary": { "solid": { "color": "#FFFFFF" } }, "backColorSecondary": { "solid": { "color": "#F6F8FB" } } }],
        "total": [{ "fontSize": 11 }],
        "grid": [{ "gridHorizontal": true, "gridHorizontalColor": { "solid": { "color": "#E6EAF0" } }, "rowPadding": 4 }]
      }
    },
    "slicer": {
      "*": {
        "items": [{ "textSize": 12 }],
        "header": [{ "textSize": 11 }]
      }
    }
  }
}
